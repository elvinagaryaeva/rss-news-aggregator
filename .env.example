DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/rss_aggregator
RSS_FETCH_INTERVAL_SECONDS=300
RSS_REQUEST_TIMEOUT_SECONDS=20
APP_PORT=8000
ENVIRONMENT=development
INTERNAL_BASE_URL=http://app:8000
PUBLIC_BASE_URL=http://localhost:8000
SEMANTIC_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SESSION_SECRET=change-this-for-a-shared-deployment
# Format: Name|https://example.com/feed.xml;Another feed|https://example.org/rss
DEMO_RSS_FEEDS=Hacker News|https://hnrss.org/frontpage;BBC World|https://feeds.bbci.co.uk/news/world/rss.xml;NASA Breaking News|https://www.nasa.gov/rss/dyn/breaking_news.rss
